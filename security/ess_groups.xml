<odoo>
    <record id="module_category_ess" model="ir.module.category">
        <field name="name">Employee Self Service</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_ess" model="res.groups.privilege">
        <field name="name">Employee Self Service</field>
        <field name="category_id" ref="employee_self_service.module_category_ess"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_ess_employee" model="res.groups">
        <field name="name">ESS Employee</field>
        <field name="privilege_id" ref="employee_self_service.privilege_ess"/>
    </record>

    <record id="group_ess_administrator" model="res.groups">
        <field name="name">ESS Administrator</field>
        <field name="privilege_id" ref="employee_self_service.privilege_ess"/>
        <field name="implied_ids" eval="[(4, ref('employee_self_service.group_ess_employee'))]"/>
    </record>

    <record id="group_ess_hr_manager" model="res.groups">
        <field name="name">ESS HR Manager</field>
        <field name="privilege_id" ref="employee_self_service.privilege_ess"/>
        <field name="implied_ids" eval="[(4, ref('employee_self_service.group_ess_employee'))]"/>
    </record>
</odoo>
