<odoo>
    <record id="module_category_ess" model="ir.module.category"><field name="name">Employee Self Service</field><field name="sequence">30</field></record>
    <record id="group_ess_employee" model="res.groups"><field name="name">ESS Employee</field><field name="category_id" ref="employee_self_service.module_category_ess"/></record>
    <record id="group_ess_shared_account" model="res.groups"><field name="name">ESS Shared Account</field><field name="category_id" ref="employee_self_service.module_category_ess"/></record>
    <record id="group_ess_hr_manager" model="res.groups"><field name="name">ESS HR Manager</field><field name="category_id" ref="employee_self_service.module_category_ess"/><field name="implied_ids" eval="[(4, ref('group_ess_employee'))]"/></record>
    <record id="group_ess_administrator" model="res.groups"><field name="name">ESS Administrator</field><field name="category_id" ref="employee_self_service.module_category_ess"/><field name="implied_ids" eval="[(4, ref('group_ess_hr_manager'))]"/></record>
</odoo>
